{
	"name": "pi-omlx-picker",
	"version": "0.3.6",
	"type": "module",
	"description": "Pi extension that discovers models from a local OMLX server and registers them as a native Pi provider.",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"omlx",
		"pi",
		"picker",
		"model"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"check": "biome check *.ts *.json src test scripts && tsc --noEmit && vitest run",
		"format": "biome check --write *.ts *.json src test scripts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"release": "npm publish --access public"
	},
	"files": [
		"index.ts",
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@earendil-works/pi-ai": "^0.80.9",
		"@earendil-works/pi-coding-agent": "^0.82.1",
		"@types/node": "latest",
		"tsx": "latest",
		"typescript": "latest",
		"vitest": "latest"
	},
	"allowScripts": {
		"@google/genai@1.52.0": true,
		"protobufjs@7.5.9": true,
		"protobufjs@7.6.4": true,
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true
	}
}
