{
	"name": "pi-omlx-picker",
	"version": "0.2.4",
	"type": "module",
	"description": "Pi extension that discovers models from a local OMLX server and registers them as a native Pi provider.",
	"license": "MIT",
	"keywords": [
		"pi-package"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"check": "biome check *.ts *.json src test scripts && tsc --noEmit && vitest run",
		"format": "biome check --write *.ts *.json src test scripts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"publish": "npm publish --access public"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@earendil-works/pi-ai": "0.75.5",
		"@earendil-works/pi-coding-agent": "0.75.5",
		"@types/node": "^25.9.2",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.7"
	}
}
